# ---- Firebase Admin (backend) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Chave privada com \n escapados em uma única linha
FIREBASE_PRIVATE_KEY=

# ---- Firebase Auth (client — login do painel) ----
# Valores públicos do app web no Firebase Console (Project settings > Your apps).
# Habilitar em Authentication > Sign-in method: Google e E-mail/senha.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- IA (cérebro da Livia) ----
OPENAI_API_KEY=
# Modelo usado nas respostas (padrão gpt-4o-mini, bom custo/qualidade)
LIVIA_MODEL=gpt-4o-mini

# ---- WhatsApp (Meta Cloud API) ----
# String que VOCÊ define; precisa ser idêntica à informada no painel da Meta
# ao configurar o webhook (Verify token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- WhatsApp Embedded Signup (Tech Provider) ----
# Reaproveita o app/fluxo do Nuvem Rush OU cria um app próprio da Livia.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_ES_CONFIG_ID=
# Chave mestra (AES-256, 32 bytes em base64) para cifrar o accessToken do
# WhatsApp de cada estabelecimento em repouso no Firestore (lib/whatsapp/
# tokenCrypto.ts). Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_TOKEN_ENC_KEY=

# ---- Segurança interna ----
CRON_SECRET=
