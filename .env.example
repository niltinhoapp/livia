# ---- Firebase Admin (backend) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Chave privada com \n escapados em uma única linha
FIREBASE_PRIVATE_KEY=
# Bucket privado usado para anexos das conversas (sem URL pública).
FIREBASE_STORAGE_BUCKET=

# ---- Firebase Auth (client — login do painel) ----
# Valores públicos do app web no Firebase Console (Project settings > Your apps).
# Habilitar em Authentication > Sign-in method: Google e E-mail/senha.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- IA (cérebro da Livia) ----
OPENAI_API_KEY=
# Modelo usado nas respostas (padrão gpt-4o-mini, bom custo/qualidade)
LIVIA_MODEL=gpt-4o-mini
# Opcional: modelo separado apenas para áudio -> texto. Usa OPENAI_API_KEY.
LIVIA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# ---- TTS (texto -> áudio nas respostas de voz da Lívia) ----
# Todos opcionais. Sem configuração, os padrões abaixo são usados.
# Modelo de síntese de voz (padrão: gpt-4o-mini-tts)
LIVIA_TTS_MODEL=gpt-4o-mini-tts
# Voz (padrão: nova — feminina, natural, conversacional)
# Outras disponíveis: shimmer, coral, sage, alloy, echo, onyx, fable, ash
LIVIA_TTS_VOICE=nova
# Instrução de estilo enviada ao modelo. Controla tom, ritmo e personalidade.
# Substitua sem redeploy para ajuste fino. Deixe em branco para usar o padrão.
# LIVIA_TTS_INSTRUCTIONS=

# ---- WhatsApp (Meta Cloud API) ----
# String que VOCÊ define; precisa ser idêntica à informada no painel da Meta
# ao configurar o webhook (Verify token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- WhatsApp Embedded Signup (Tech Provider) ----
# Reaproveita o app/fluxo do Nuvem Rush OU cria um app próprio da Livia.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_ES_CONFIG_ID=
# Chave mestra (AES-256, 32 bytes em base64) para cifrar o accessToken do
# WhatsApp de cada estabelecimento em repouso no Firestore (lib/whatsapp/
# tokenCrypto.ts). Gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_TOKEN_ENC_KEY=

# ---- Livia Payments: conexão Mercado Pago OAuth (server-side) ----
# Configure a mesma Redirect URL estática no app Mercado Pago e nesta variável.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=
# Chave mestre AES-256 exclusiva para tokens OAuth de Payment Connections.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_CONNECTION_TOKEN_ENC_KEY=

# ---- Segurança interna ----
CRON_SECRET=
# Kill switch: só "true" permite ativar/processar campanhas. Default fechado.
CAMPAIGNS_SEND_ENABLED=false
# Limite operacional por campanha; o primeiro teste recomendado usa 5.
CAMPAIGNS_MAX_RECIPIENTS_PER_CAMPAIGN=5
# UIDs Firebase dos operadores da plataforma, separados por vírgula.
# Exclusivamente server-side; sem configuração, o provisionamento falha fechado.
PANEL_ADMIN_UIDS=
